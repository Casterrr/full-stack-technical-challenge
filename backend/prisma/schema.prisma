generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EducacaoRegistro {
  id         Int     @id @default(autoincrement())
  coMun      String  @map("co_mun") @db.VarChar(7)
  noMun      String  @map("no_mun")
  ano        Int
  fonte      String
  variavel   String
  ensinoRede String  @map("ensino_rede")
  ensinoTipo String  @map("ensino_tipo")
  valor      Decimal @db.Decimal(18, 4)

  @@index([ano, variavel, ensinoRede, ensinoTipo])
  @@index([coMun])
  @@index([variavel, ano])
  @@map("educacao_registros")
}
