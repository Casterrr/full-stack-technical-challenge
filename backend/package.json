{
  "name": "educacao-alagoas-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do dashboard de educação de Alagoas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "parse:sample": "tsx scripts/parseSample.ts",
